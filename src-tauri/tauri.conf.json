{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Showa Video Cabinet",
  "version": "0.1.0",
  "identifier": "com.alek.showavideocabinet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "昭和ビデオ・キャビネット",
        "width": 1512,
        "height": 945,
        "minWidth": 1200,
        "minHeight": 750,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "backgroundColor": "#0B0806"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://i.ytimg.com https://*.b-cdn.net",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self' https://www.youtube.com https://s.ytimg.com",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com https://iframe.mediadelivery.net",
        "media-src": "'self' blob: https://*.b-cdn.net https://sc.j1fm.com https://*.j1fm.com",
        "connect-src": "'self' ipc: http://ipc.localhost https://www.youtube.com https://s.ytimg.com https://*.b-cdn.net https://video.bunnycdn.com https://sc.j1fm.com https://*.j1fm.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Private family project. Not for distribution.",
    "category": "Entertainment",
    "shortDescription": "昭和ビデオ・キャビネット",
    "longDescription": "A private entertainment cabinet of Showa-era songs, nostalgic Japanese footage, personal videos and photographs.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "dmg": {
        "appPosition": { "x": 180, "y": 220 },
        "applicationFolderPosition": { "x": 480, "y": 220 },
        "windowSize": { "width": 660, "height": 420 }
      }
    }
  }
}
