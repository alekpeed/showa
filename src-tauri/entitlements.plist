<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required under Hardened Runtime for getUserMedia to reach the mic.
         Without this the app is notarized but the telephone silently fails. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
